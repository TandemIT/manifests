# Proxmox Connection
proxmox_api_url          = "https://<YOUR_PROXMOX_HOST>:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "YOUR_TOKEN_SECRET_HERE"

# The VM password is NOT set here: export TF_VAR_vm_password before deploy.sh.

# SSH Key
ssh_public_key = "ssh-ed25519 YOUR_PUBLIC_KEY_HERE"

# Proxmox Settings
# The template needs qemu-guest-agent: the apply waits for it (agent = 1).
# Optional vendor snippet; clones don't inherit the template's cicustom.
# cloudinit_vendor_snippet = "local:snippets/ubuntu-noble.yaml"

proxmox_node = "proxmox"
template_id  = "ubuntu-24.04-cloud-tpl"
vm_id_start  = 200 # control plane: 200..; workers: 300..
storage      = "local-zfs"
bridge       = "vmbr0"
vlan_tag     = 0 # 0 = untagged; set when the bridge is VLAN-aware
# public_vlan_tag = 0 # 2nd NIC (no address) for the MetalLB IP: 0 = untagged/native VLAN, N = tag N
# public_gateway  = "203.0.113.1" # required with public_vlan_tag: router on that VLAN
gateway      = "172.16.10.1"
nameserver   = "172.16.10.1"
searchdomain = "local"

# Control Plane Configuration (3 nodes for etcd quorum + kube-vip HA)
control_plane_count     = 3
control_plane_cpu       = 2
control_plane_memory    = 4096
control_plane_disk_size = "15G"
control_plane_ip_start  = "172.16.10.100"

# Worker Configuration
worker_count     = 3
worker_cpu       = 1
worker_memory    = 2048
worker_disk_size = "10G"
worker_ip_start  = "172.16.10.150"

# K3s Configuration
k3s_version = "v1.32.3+k3s1"

# Control-plane VIP (kube-vip), outside the node ranges. The MetalLB address
# (platform/metallb/ipaddresspool.yaml) is a separate public IP.
vip = "172.16.10.50"

# Nodes and Argo CD pull from here: push before deploying.
manifests_repo     = "https://github.com/TandemIT/manifests.git"
manifests_revision = "master"

# Gitea OIDC providers (optional, any number), keyed by slug. Create the
# OAuth2 application in your identity provider yourself; this repo doesn't.
# Re-run scripts/06-auth-providers.sh after changing them. {} = none.
gitea_oidc_providers = {
  # authentik = {
  #   display_name  = "Authentik"
  #   client_id     = "YOUR_CLIENT_ID"
  #   client_secret = "YOUR_CLIENT_SECRET"
  #   discovery_url = "https://auth.open-ict.hu/application/o/gitea/.well-known/openid-configuration"
  #   icon_url      = "https://auth.open-ict.hu/static/dist/assets/icons/icon.png"
  # }
  # keycloak = {
  #   display_name  = "Keycloak"
  #   client_id     = "YOUR_CLIENT_ID"
  #   client_secret = "YOUR_CLIENT_SECRET"
  #   discovery_url = "https://keycloak.example.com/realms/main/.well-known/openid-configuration"
  # }
}

# Gitea LDAP providers (optional, any number) for an existing LDAP/AD server.
# {} = none.
gitea_ldap_providers = {
  # authentik = {
  #   display_name     = "Authentik LDAP"
  #   host             = "ldap.open-ict.hu"
  #   port             = 636
  #   security_protocol = "LDAPS"
  #   bind_dn          = "cn=gitea,ou=service-accounts,dc=open-ict,dc=hu"
  #   bind_password    = "YOUR_BIND_PASSWORD"
  #   user_search_base = "ou=users,dc=open-ict,dc=hu"
  #   user_filter      = "(&(objectClass=user)(memberOf=cn=gitea-users,ou=groups,dc=open-ict,dc=hu)(uid=%s))"
  #   admin_filter     = "(memberOf=cn=gitea-admins,ou=groups,dc=open-ict,dc=hu)"
  # }
}
