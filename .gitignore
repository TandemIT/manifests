# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfvars
!terraform.tfvars.example
crash.log
*.log
# .terraform.lock.hcl is deliberately NOT ignored - HashiCorp recommends
# committing it so provider version/checksum changes go through code review:
# https://developer.hashicorp.com/terraform/language/files/dependency-lock
# It pins registry.opentofu.org (deploy.sh's default binary); refresh with
# `tofu -chdir=terraform providers lock -platform=linux_amd64 ...`.

# Ansible
*.retry
ansible/*.retry
# Generated by Terraform (local_file.ansible_inventory in terraform/main.tf)
ansible/inventory.yml

# Kubeconfig
kubeconfig
*.kubeconfig

